{
  "expo": {
    "name": "ZERO",
    "slug": "zero",
    "version": "0.3.0",
    "orientation": "default",
    "scheme": "zero",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "zero",
          "color": "#e94458"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "android": {
      "package": "com.novacore.zero",
      "adaptiveIcon": {
        "backgroundColor": "#151216"
      }
    },
    "ios": {
      "bundleIdentifier": "com.novacore.zero",
      "supportsTablet": true
    }
  }
}
